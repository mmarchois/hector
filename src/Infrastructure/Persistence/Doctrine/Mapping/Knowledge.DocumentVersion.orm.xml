<?xml version="1.0" encoding="utf-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
  <!-- Un libellé de version par source -->
  <entity name="App\Domain\Knowledge\DocumentVersion" table="knowledge_document_version">
    <unique-constraints>
        <unique-constraint columns="source_uuid,label" name="uniq_knowledge_document_version_label"/>
    </unique-constraints>
    <id name="uuid" type="guid" column="uuid"/>
    <field name="label" type="string" column="label" length="120" nullable="false"/>
    <field name="publishedOn" type="date_immutable" column="published_on" nullable="true"/>
    <field name="effectiveFrom" type="date_immutable" column="effective_from" nullable="true"/>
    <field name="effectiveUntil" type="date_immutable" column="effective_until" nullable="true"/>
    <field name="replacesUuid" type="guid" column="replaces_uuid" nullable="true"/>
    <field name="fileName" type="string" column="file_name" length="255" nullable="false"/>
    <field name="fileFingerprint" type="string" column="file_fingerprint" length="64" nullable="false"/>
    <field name="storageKey" type="string" column="storage_key" length="255" nullable="false"/>
    <field name="status" type="string" column="status" length="16" enum-type="App\Domain\Knowledge\DocumentStatus" nullable="false"/>
    <field name="reviewedBy" type="string" column="reviewed_by" length="255" nullable="true"/>
    <field name="reviewedAt" type="datetimetz_immutable" column="reviewed_at" nullable="true"/>
    <field name="withdrawnAt" type="datetimetz_immutable" column="withdrawn_at" nullable="true"/>
    <field name="createdAt" type="datetimetz_immutable" column="created_at" nullable="false"/>
    <many-to-one field="source" target-entity="App\Domain\Knowledge\Source">
        <join-column name="source_uuid" referenced-column-name="uuid" nullable="false"/>
    </many-to-one>
  </entity>
</doctrine-mapping>
