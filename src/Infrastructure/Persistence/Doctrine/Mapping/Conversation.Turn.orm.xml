<?xml version="1.0" encoding="utf-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
  <entity name="App\Domain\Conversation\Turn" table="conversation_turn">
    <id name="uuid" type="guid" column="uuid"/>
    <field name="status" type="string" column="status" length="16" enum-type="App\Domain\Conversation\TurnStatus" nullable="false"/>
    <field name="createdAt" type="datetimetz_immutable" column="created_at" nullable="false"/>
    <field name="finishedAt" type="datetimetz_immutable" column="finished_at" nullable="true"/>
    <field name="failure" type="string" column="failure" length="16" enum-type="App\Domain\Conversation\TurnFailure" nullable="true"/>
    <!-- Trace du tour (CV6), dans la même ligne : écrite une fois, à la fin du tour -->
    <embedded name="trace" class="App\Domain\Conversation\TurnTrace" column-prefix="trace_"/>
    <many-to-one field="conversation" target-entity="App\Domain\Conversation\Conversation">
        <join-column name="conversation_uuid" referenced-column-name="uuid" nullable="false" on-delete="CASCADE"/>
    </many-to-one>
    <one-to-one field="userMessage" target-entity="App\Domain\Conversation\Message">
        <join-column name="user_message_uuid" referenced-column-name="uuid" nullable="false" unique="true" on-delete="CASCADE"/>
    </one-to-one>
    <one-to-one field="assistantMessage" target-entity="App\Domain\Conversation\Message">
        <join-column name="assistant_message_uuid" referenced-column-name="uuid" nullable="true" unique="true" on-delete="CASCADE"/>
    </one-to-one>
  </entity>
</doctrine-mapping>
