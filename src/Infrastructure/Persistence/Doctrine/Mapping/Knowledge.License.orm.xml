<?xml version="1.0" encoding="utf-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
  <embeddable name="App\Domain\Knowledge\License">
    <field name="indexingAllowed" type="boolean" column="indexing_allowed" nullable="false"/>
    <field name="excerptAllowed" type="boolean" column="excerpt_allowed" nullable="false"/>
    <field name="excerptMaxCharacters" type="integer" column="excerpt_max_characters" nullable="true"/>
    <field name="thirdPartyTransferAllowed" type="boolean" column="third_party_transfer_allowed" nullable="false"/>
    <field name="origin" type="string" column="origin" length="255" nullable="false"/>
  </embeddable>
</doctrine-mapping>
