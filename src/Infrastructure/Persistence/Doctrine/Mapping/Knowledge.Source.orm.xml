<?xml version="1.0" encoding="utf-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
  <!-- KN7 : une source appartient à un seul corpus -->
  <entity name="App\Domain\Knowledge\Source" table="knowledge_source">
    <id name="uuid" type="guid" column="uuid"/>
    <field name="corpus" type="string" column="corpus" length="32" enum-type="App\Domain\Knowledge\Corpus" nullable="false"/>
    <field name="title" type="string" column="title" length="255" nullable="false"/>
    <field name="publisher" type="string" column="publisher" length="255" nullable="false"/>
    <field name="kind" type="string" column="kind" length="32" enum-type="App\Domain\Knowledge\SourceKind" nullable="false"/>
    <field name="domains" type="json" column="domains" nullable="false"/>
    <field name="createdAt" type="datetimetz_immutable" column="created_at" nullable="false"/>
    <embedded name="license" class="App\Domain\Knowledge\License" column-prefix="license_"/>
  </entity>
</doctrine-mapping>
