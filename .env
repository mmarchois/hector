# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="postgresql://hector:hector@database:5432/hector?serverVersion=17&charset=utf8"
###< doctrine/doctrine-bundle ###

###> lexik/jwt-authentication-bundle ###
# Valeurs de DEV uniquement : la production surcharge ces trois variables
# (clés PEM + passphrase dédiées), cf. README « Mise en production ».
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=hector_dev_passphrase_change_me
###< lexik/jwt-authentication-bundle ###

###> Modèle de langage (lot L5) ###
# Clé dans .env.local uniquement, jamais dans le dépôt : ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-opus-5-5
# low, medium, high, xhigh, max : medium par défaut sur Claude Opus 5.5, à régler sur mesure (lot L8)
CHAT_EFFORT=medium
CHAT_MAX_TOKENS=16000
# Délai par appel ; une seule nouvelle tentative (nginx : fastcgi_read_timeout 240s)
CHAT_TIMEOUT_SECONDS=90
# Coupe-circuit : jetons consommés par tous les utilisateurs sur 24 heures glissantes (CV9).
# Au-delà, tout nouveau message reçoit une 503 service_saturated. À régler en production
# d'après le budget accepté chez le fournisseur.
CHAT_DAILY_TOKEN_BUDGET=5000000
###< Modèle de langage ###
